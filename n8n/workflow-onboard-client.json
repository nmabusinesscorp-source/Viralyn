{
  "name": "Viralyn — Onboard Client",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "onboard-client",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000001-0001-0001-0001-000000000001",
      "name": "Webhook Onboard",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 304],
      "webhookId": "onboard-client"
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appGeibRFjtIvEGll"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "Customers"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Customer_ID": "={{ $json.body.customer.Customer_ID }}",
            "Customer_Name": "={{ $json.body.customer.Customer_Name }}",
            "Customer_Status": "={{ $json.body.customer.Customer_Status || 'En review' }}",
            "Customer_Adress": "={{ $json.body.customer.Customer_Adress }}",
            "Customer_Market": "={{ $json.body.customer.Customer_Market }}",
            "Customer_Website": "={{ $json.body.customer.Source_URL }}",
            "Customer_Contact": "={{ $json.body.customer.Customer_Contact }}",
            "Customer_Email": "={{ $json.body.customer.Customer_Email }}",
            "Customer_Phone": "={{ $json.body.customer.Customer_Phone }}",
            "CTA": "={{ $json.body.customer.CTA }}",
            "Mood": "={{ $json.body.customer.Mood }}",
            "Visual_type": "={{ $json.body.customer.Visual_type }}",
            "Visual_to_Video_type": "={{ $json.body.customer.Visual_to_Video_type }}",
            "Color_Set": "={{ $json.body.customer.Color_Set }}",
            "Target_Personna": "={{ $json.body.customer.Target_Personna }}",
            "Blotato_Client_ID": "={{ $json.body.customer.Blotato_Client_ID }}",
            "Telegram_Chat_ID": "={{ $json.body.customer.Telegram_Chat_ID }}",
            "Logo_URL": "={{ $json.body.customer.Logo_URL }}"
          }
        },
        "options": {}
      },
      "id": "a1000001-0001-0001-0001-000000000002",
      "name": "Create Customer",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [528, 184],
      "credentials": {
        "airtableTokenApi": {
          "id": "YtjWlkMv0kUOReCD",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "products",
              "value": "={{ $json.body.products }}",
              "type": "array"
            },
            {
              "id": "p2",
              "name": "customer_id",
              "value": "={{ $json.body.customer.Customer_ID }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000001-0001-0001-0001-000000000004",
      "name": "Set Products Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [528, 424]
    },
    {
      "parameters": {
        "fieldToSplitOut": "products",
        "options": {
          "include": "allOtherFields"
        }
      },
      "id": "a1000001-0001-0001-0001-000000000005",
      "name": "Split Products",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [752, 424]
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appGeibRFjtIvEGll"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "Products"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Product_Name": "={{ $json.Product_Name }}",
            "Description": "={{ $json.Description }}",
            "Category": "={{ $json.Category }}",
            "Price": "={{ $json.Price }}",
            "Is_Active": "={{ $json.Is_Active }}",
            "Visual_Keywords": "={{ $json.Visual_Keywords }}",
            "Customer_ID": "={{ $json.customer_id }}"
          }
        },
        "options": {}
      },
      "id": "a1000001-0001-0001-0001-000000000006",
      "name": "Create Products",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [960, 424],
      "credentials": {
        "airtableTokenApi": {
          "id": "YtjWlkMv0kUOReCD",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "parameters": {
        "mode": "chooseBranch",
        "output": "empty"
      },
      "id": "a1000001-0001-0001-0001-000000000008",
      "name": "Wait All Done",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1200, 304]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, customer_id: $(\"Webhook Onboard\").item.json.body.customer.Customer_ID, message: \"Customer and products created in Airtable\" }) }}",
        "options": {}
      },
      "id": "a1000001-0001-0001-0001-000000000007",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 304]
    }
  ],
  "connections": {
    "Webhook Onboard": {
      "main": [
        [
          { "node": "Create Customer", "type": "main", "index": 0 },
          { "node": "Set Products Data", "type": "main", "index": 0 }
        ]
      ]
    },
    "Create Customer": {
      "main": [
        [
          { "node": "Wait All Done", "type": "main", "index": 0 }
        ]
      ]
    },
    "Set Products Data": {
      "main": [
        [
          { "node": "Split Products", "type": "main", "index": 0 }
        ]
      ]
    },
    "Split Products": {
      "main": [
        [
          { "node": "Create Products", "type": "main", "index": 0 }
        ]
      ]
    },
    "Create Products": {
      "main": [
        [
          { "node": "Wait All Done", "type": "main", "index": 1 }
        ]
      ]
    },
    "Wait All Done": {
      "main": [
        [
          { "node": "Respond Success", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "viralyn" },
    { "name": "onboarding" }
  ]
}
